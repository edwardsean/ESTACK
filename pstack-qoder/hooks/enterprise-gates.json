{
  "description": "Enterprise approval gates for the pstack orchestrator. Dormant until a project opts in by writing .qoder/enterprise/gates.json, which /setup-enterprise does. Gate policy lives in that project file, never here, so one plugin install serves repos with different rules.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "name": "enterprise-gate-ask",
            "command": "\"${QODER_PLUGIN_ROOT}/hooks/scripts/gate-check.sh\"",
            "timeout": 10,
            "statusMessage": "checking enterprise approval gates"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "name": "enterprise-audit-write",
            "command": "\"${QODER_PLUGIN_ROOT}/hooks/scripts/audit-write.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "enterprise-gate-backstop",
            "command": "\"${QODER_PLUGIN_ROOT}/hooks/scripts/seat-backstop.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
