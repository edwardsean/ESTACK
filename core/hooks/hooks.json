{
  "description": "Enterprise approval gates for the estack orchestrator. Dormant until a project opts in by writing .claude/enterprise/gates.json, which /{{estack:ns}}:setup does. Gate policy lives in that project file, never here, so one plugin install serves repos with different rules.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gate-check.sh\"",
            "timeout": 10,
            "statusMessage": "checking enterprise approval gates"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/audit-write.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/seat-backstop.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
